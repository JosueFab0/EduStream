<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>EduStream LMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><jsp:include page="fragments/nav.jsp"/><main><jsp:include page="fragments/flash.jsp"/><p class="eyebrow">TU ESPACIO DE APRENDIZAJE</p><h1>Hola, <c:out value="${sessionScope.usuarioLogueado.nombre}"/></h1>
<p><c:choose><c:when test="${sessionScope.usuarioLogueado.rol == 'PROFESOR'}">Organiza tus cursos y consulta a tus estudiantes.</c:when><c:otherwise>Explora el catálogo y continúa aprendiendo.</c:otherwise></c:choose></p>
<div class="stats"><article><strong><c:out value="${totalCursos}"/></strong><span>Cursos disponibles para ti</span></article><article><strong><c:out value="${totalInscripciones}"/></strong><span>Inscripciones</span></article></div>
<div class="cards"><article><h2>Cursos</h2><p>Consulta los cursos y sus detalles.</p><a class="button" href="${pageContext.request.contextPath}/app/cursos">Ver cursos</a></article><article><h2>Inscripciones</h2><p>Consulta tus registros de participación.</p><a class="button secondary" href="${pageContext.request.contextPath}/app/inscripciones">Ver inscripciones</a></article></div></main><footer>EduStream · Proyecto final de Programación 2</footer></body></html>
