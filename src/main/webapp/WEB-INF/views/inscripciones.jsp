<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>EduStream LMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><jsp:include page="fragments/nav.jsp"/><main><jsp:include page="fragments/flash.jsp"/><p class="eyebrow">PARTICIPACIÓN</p><h1>Inscripciones</h1>
<c:if test="${empty inscripciones}"><p class="empty">Todavía no hay inscripciones. <a href="${pageContext.request.contextPath}/app/cursos">Ver cursos</a></p></c:if>
<c:if test="${not empty inscripciones}"><div class="table-wrap"><table><caption>Inscripciones de tus cursos</caption><thead><tr><th>Curso</th><th>Estudiante</th><th>Fecha</th><c:if test="${sessionScope.usuarioLogueado.rol == 'ESTUDIANTE'}"><th>Acción</th></c:if></tr></thead><tbody>
<c:forEach items="${inscripciones}" var="i"><tr><td><c:out value="${i.curso}"/></td><td><c:out value="${i.estudiante}"/></td><td><c:out value="${i.fecha}"/></td>
<c:if test="${sessionScope.usuarioLogueado.rol == 'ESTUDIANTE'}"><td><form action="${pageContext.request.contextPath}/app/inscripciones" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="cancelar"><input type="hidden" name="id" value="${i.id}"><button class="secondary">Cancelar inscripción</button></form></td></c:if></tr></c:forEach></tbody></table></div></c:if></main><footer>EduStream · Proyecto final de Programación 2</footer></body></html>
